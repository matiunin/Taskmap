    { "name": "POST search including empty body", "patch": { "method": "POST", "data": {} }, "status": 200 },
    { "name": "PUT issue", "patch": { "method": "PUT", "data": { "fields": {} } }, "status": 200 },
    { "name": "DELETE link", "patch": { "method": "DELETE" }, "status": 200 },
    { "name": "PATCH issue", "patch": { "method": "PATCH", "data": false }, "status": 200 },
    { "name": "HEAD Jira API", "patch": { "method": "HEAD" }, "status": 200 },
    { "name": "tenant info", "patch": { "url": "https://example.atlassian.net/_edge/tenant_info" }, "status": 200 },
    { "name": "automation search", "patch": { "url": "https://example.atlassian.net/gateway/api/automation/public/jira/cloud-id/rest/v1/rule/manual/search", "method": "POST", "data": { "objects": [] } }, "status": 200 },
    { "name": "automation invocation", "patch": { "url": "https://example.atlassian.net/gateway/api/automation/public/jira/cloud-id/rest/v1/rule/manual/rule-1/invocation", "method": "POST", "data": { "objects": [] } }, "status": 200 },
    { "name": "disallowed HTTP", "patch": { "url": "http://example.atlassian.net/rest/api/3/myself" }, "status": 403 },
    { "name": "host not configured", "patch": { "url": "https://test.atlassian.net/rest/api/3/myself" }, "status": 403 },
    { "name": "hostname suffix attack", "patch": { "url": "https://example.atlassian.net.attacker.example/rest/api/3/myself" }, "status": 403 },
    { "name": "URL credentials", "patch": { "url": "https://user:pass@example.atlassian.net/rest/api/3/myself" }, "status": 403 },
    { "name": "URL fragment", "patch": { "url": "https://example.atlassian.net/rest/api/3/myself#fragment" }, "status": 403 },
    { "name": "alternate port", "patch": { "url": "https://example.atlassian.net:444/rest/api/3/myself" }, "status": 403 },
    { "name": "IP literal", "patch": { "url": "https://127.0.0.1/rest/api/3/myself" }, "status": 403 },
    { "name": "metadata IP", "patch": { "url": "https://169.254.169.254/rest/api/3/myself" }, "status": 403 },
    { "name": "backslash URL", "patch": { "url": "https://example.atlassian.net\\attacker.example/rest/api/3/myself" }, "status": 400 },
    { "name": "URL whitespace", "patch": { "url": " https://example.atlassian.net/rest/api/3/myself" }, "status": 400 },
    { "name": "non-string URL", "patch": { "url": 12 }, "status": 400 },
    { "name": "non-API path", "patch": { "url": "https://example.atlassian.net/login" }, "status": 403 },
    { "name": "dot traversal", "patch": { "url": "https://example.atlassian.net/rest/api/3/../../../login" }, "status": 403 },
    { "name": "encoded traversal", "patch": { "url": "https://example.atlassian.net/rest/api/3/%2e%2e/login" }, "status": 403 },
    { "name": "double encoded traversal", "patch": { "url": "https://example.atlassian.net/rest/api/3/%252e%252e/login" }, "status": 403 },
    { "name": "encoded path separator", "patch": { "url": "https://example.atlassian.net/rest/api/3/issue%2fA-1" }, "status": 403 },
    { "name": "encoded newline", "patch": { "url": "https://example.atlassian.net/rest/api/3/issue%0aA-1" }, "status": 403 },
    { "name": "invalid percent", "patch": { "url": "https://example.atlassian.net/rest/api/3/issue%xx" }, "status": 400 },
    { "name": "double slash", "patch": { "url": "https://example.atlassian.net/rest/api/3//myself" }, "status": 403 },
    { "name": "tenant info write", "patch": { "url": "https://example.atlassian.net/_edge/tenant_info", "method": "POST" }, "status": 403 },
    { "name": "arbitrary automation path", "patch": { "url": "https://example.atlassian.net/gateway/api/automation/public/jira/cloud-id/rest/v1/rule/other", "method": "POST" }, "status": 403 },
    { "name": "TRACE method", "patch": { "method": "TRACE" }, "status": 405 },
    { "name": "CONNECT method", "patch": { "method": "CONNECT" }, "status": 405 },
    { "name": "OPTIONS method", "patch": { "method": "OPTIONS" }, "status": 405 },
    { "name": "null method", "patch": { "method": null }, "status": 405 },
    { "name": "method injection", "patch": { "method": "GET\r\nX-Foo: yes" }, "status": 405 },
    { "name": "arbitrary upstream headers", "patch": { "headers": { "Host": "internal.example" } }, "status": 400 },
    { "name": "null auth", "patch": { "auth": null }, "status": 400 },
    { "name": "missing password", "patch": { "auth": { "username": "person@example.com" } }, "status": 400 },
    { "name": "auth header injection", "patch": { "auth": { "username": "person@example.com", "password": "test\r\nX-Foo: yes" } }, "status": 400 },
    { "name": "auth username delimiter", "patch": { "auth": { "username": "person:extra", "password": "test-value" } }, "status": 400 },
    { "name": "mixed auth", "patch": { "token": "test-bearer" }, "status": 400 },
    { "name": "GET body", "patch": { "data": {} }, "status": 400 }
  ],
