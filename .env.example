# Server settings only. Never put Jira tokens or passwords in VITE_* variables.
# Exact Jira hostnames, comma-separated, without https:// or paths.
TASKMAP_JIRA_HOSTS=example.atlassian.net

# Set this to the exact browser origin when serving behind an HTTPS reverse proxy.
# Leave blank for the same-origin local Docker/dev setup.
TASKMAP_PUBLIC_ORIGIN=

# Local development defaults. The production container uses Apache, not this port.
TASKMAP_PROXY_PORT=3004
DEV_HOST=127.0.0.1
# Optional comma-separated development hostnames; never use an unrestricted wildcard.
DEV_ALLOWED_HOSTS=

# Optional PUBLIC same-origin browser API path; never include credentials here.
# This is embedded at build time, so rebuild after changing it.
VITE_JIRA_PROXY_URL=
